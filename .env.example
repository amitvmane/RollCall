# ============================================================================
# RollCall — environment configuration
# ----------------------------------------------------------------------------
# Copy to .env:   cp .env.example .env
#
# How this file works:
#   • Commented lines (starting with #) are IGNORED — the app / Docker Compose
#     falls back to the default shown next to each one. Uncomment a line to
#     override it.
#   • Only API_KEY is strictly required. Everything else is optional.
#   • .env is the single source of truth for both Docker and local runs.
# ============================================================================


# ── REQUIRED ────────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather.
API_KEY="YOUR_TELEGRAM_BOT_TOKEN_HERE"
# TELEGRAM_TOKEN is an accepted alias for API_KEY. In Docker it is derived from
# API_KEY automatically; set it only for a local run if you don't use API_KEY.
# TELEGRAM_TOKEN=

# Super-admin Telegram user IDs (integers; get yours from @userinfobot).
# Enables /broadcast and receives `make notify` links. Leave blank to disable.
ADMIN1=
ADMIN2=


# ── DATABASE ─────────────────────────────────────────────────────────────────

# Where the database lives ON THE HOST. Bind-mounted to /app/data inside the
# container, so DATABASE_URL never changes. Defaults to ../rollcall-data —
# deliberately OUTSIDE the git working tree, so no checkout, `git clean -fdx`,
# or stash can touch production data. Set an absolute path here on a server so
# it never depends on the working directory:
# DATA_DIR=/home/rock/rollcall-data
#
# Migrate an existing ./data deployment with:  make migrate-data

# SQLite (default) or PostgreSQL DSN.
#   Docker default: sqlite:////app/data/rollcall.db   (persisted to $DATA_DIR)
#   Local  default: sqlite:///rollcall.db
#   Postgres:       postgresql://user:password@host:5432/rollcall
# DATABASE_URL=postgresql://user:password@host:5432/rollcall

# ── POSTGRES (optional, profile-gated container) ─────────────────────────────
#
# docker-compose.yml ships a `postgres` service behind the `postgres` profile,
# so it never starts unless you ask for it. To use it:
#
#   1. Uncomment the DATABASE_URL line below. The host is `postgres` — the
#      compose service name — NOT localhost.
#   2. make up-postgres      (starts Postgres, waits for health, starts the bot)
#
# Data lives in the `pgdata` Docker volume, not in DATA_DIR. It survives
# `docker compose down` but not `docker compose down -v`.
#
# DATABASE_URL=postgresql://rollcall:rollcall@postgres:5432/rollcall
# POSTGRES_USER=rollcall
# POSTGRES_PASSWORD=change-me-before-using-this-for-real
# POSTGRES_DB=rollcall
# POSTGRES_HOST_PORT=5432       # bound to 127.0.0.1 only; change if 5432 is taken
#
# NOTE: the SQLite snapshot sidecar no-ops on Postgres — schedule pg_dump.

# In-memory SQLite — all data lost on restart (original v1 behaviour).
# Overrides DATABASE_URL when true. Default: false
# MEMORY_MODE=false

# PostgreSQL connection pool bounds (ignored for SQLite).
# DB_POOL_MINCONN=1
# DB_POOL_MAXCONN=5


# ── BOT RUNTIME ──────────────────────────────────────────────────────────────

# Timezone for logs and scheduling. Default: Asia/Kolkata
# TZ=Asia/Kolkata

# Ghost auto-forgive window, in days. Default: 7. Set to 0 to disable.
#
# After a rollcall ends the bot asks "any ghosts?" — answering it is what both
# records no-shows AND forgives one absence for everyone who did attend. Admins
# reliably answer it when someone ghosted, and skip it when everyone showed up
# (it feels like a no-op), so absences accumulate but are never forgiven. A
# member who ghosted once then attended for months stays flagged, and gets a
# reconfirmation prompt on every /in.
#
# This setting closes that gap: a session still unanswered after N days is
# treated as "everyone who was IN attended". It can only ever forgive — an
# unanswered session never recorded a ghost against anyone in the first place.
#
# The trade-off: once a session is auto-forgiven it is closed, so /mark_absent
# can no longer record no-shows for it. Raise this if your group reviews
# sessions late; lower it if you never review them at all.
# GHOST_AUTOFORGIVE_DAYS=7

# Health-check endpoint. HEALTH_CHECK_HOST_PORT is the port published ON THE
# HOST — change this if 8080 is already taken by another container/service.
# HEALTH_CHECK_PORT is the port inside the container; leave it at 8080.
# HEALTH_CHECK_HOST_PORT=8090
# HEALTH_CHECK_PORT=8080

# Webhook mode: set to your public HTTPS URL to switch off long-polling.
# Leave unset (default) for long-polling.
# Served via the blobsystems Nginx + Cloudflare Tunnel — see
# ../blobsystems/INFRA_PLAN.md.
# WEBHOOK_URL=https://rbot.blobsystems.xyz/webhook

# Verifies incoming /webhook POSTs actually came from Telegram (checked
# against the X-Telegram-Bot-Api-Secret-Token header Telegram echoes back).
# The webhook URL above isn't itself secret — without this, anyone who finds
# it could POST forged updates. Optional: auto-generated on startup if left
# unset whenever WEBHOOK_URL is set, and re-registered with Telegram on
# every restart, so persistence isn't required. Set it explicitly only if
# you want a stable value across restarts.
# WEBHOOK_SECRET_TOKEN=


# ── WEB APP / MINI APP / REST API ────────────────────────────────────────────

# Turn on the FastAPI server (required for web voting, Mini App, admin, portal).
# Default: false
# REST_API_ENABLED=true

# REST API bind + port. Docker default host 0.0.0.0 (so Nginx can reach it
# over the shared Docker network); local default 127.0.0.1. Default port 8081.
# REST_API_PORT=8081
# REST_API_HOST=0.0.0.0

# Serve the interactive API docs (/api/docs, /api/redoc, OpenAPI schema).
# Default: false. They are unauthenticated AND exempt from the rate limiter,
# so on a publicly reachable deployment they hand any visitor a complete,
# unthrottled map of every endpoint. Turn on only for local API work.
# API_DOCS_ENABLED=true

# Direct peers trusted to set X-Forwarded-For, so request.client (and every
# anonymous rate-limit bucket keyed on it) sees the real visitor IP instead
# of the proxy's — without this every unauthenticated request looks like it
# comes from the same internal IP and shares one rate-limit bucket. Default
# "*" is safe here because REST_API_PORT above is never published to the
# host (docker-compose.yml) — only the Nginx/Cloudflare Tunnel proxy on the
# shared Docker network can ever be the direct peer. Tighten to that proxy's
# actual container IP/CIDR if REST_API_PORT ever gets exposed to the host.
# TRUSTED_PROXY_IPS=*

# Public HTTPS base URL — enables web voting links in panels and /weblink.
# Routed by the blobsystems infra repo's Nginx + Cloudflare Tunnel
# (rbot.blobsystems.xyz), not by a cloudflared sidecar in this repo anymore.
# WEB_BASE_URL=https://rbot.blobsystems.xyz

# Public URL of the Mini App (usually <WEB_BASE_URL>/miniapp/) — sets the
# Telegram menu button on startup. Leave unset to disable the button.
# MINIAPP_URL=https://rbot.blobsystems.xyz/miniapp/


# ── WEB PUSH (VAPID) ─────────────────────────────────────────────────────────

# Keys for browser push notifications. If unset, a pair is generated on first
# use and stored in the DB. Set explicitly to keep push subscriptions valid
# across DB moves / server migrations.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=


# ── SECURITY (REST API) ──────────────────────────────────────────────────────

# Comma-separated allowed CORS origins. Default: WEB_BASE_URL above if set
# (falls back to * only when WEB_BASE_URL is also unset). Override to add
# extra origins or widen it, e.g. https://your-domain,https://other-domain
# CORS_ALLOWED_ORIGINS=

# Per-client rate limit for the REST API. Defaults: 60 requests / 60 seconds.
# REST_API_RATE_LIMIT_WINDOW_SECONDS=60
# REST_API_RATE_LIMIT_MAX_REQUESTS=60


# ── LOGGING & ERROR REPORTING ────────────────────────────────────────────────

# Emit one-line JSON logs for aggregators. Default: false (plain text)
# STRUCTURED_LOGS=false

# Sentry error reporting (requires the optional sentry-sdk dependency).
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0
# RELEASE_VERSION=
# ENVIRONMENT=production


# ── BACKUPS (db-backup sidecar) ──────────────────────────────────────────────

# Daily SQLite backup rotation (see scripts/backup_db.sh).
# BACKUP_RETENTION_DAYS=7
# BACKUP_INTERVAL_SECONDS=86400

# Where snapshots are written, and where /health looks to report their age.
# BACKUP_DIR=/app/data/backups

# Newest snapshot older than this is reported as STALE by the /health endpoint,
# the /health bot command, and `make backup-check`. Never returns 503 — a stale
# backup doesn't mean the bot is unhealthy, and a 503 would have Docker restart
# a perfectly working bot.
# BACKUP_MAX_AGE_HOURS=48


# ── OFF-SITE BACKUP (backup-sync sidecar) ───────────────────────────────────
#
# Copies $DATA_DIR/backups/ to any rclone remote (Google Drive, S3, B2, etc.)
# once per interval. Uses `rclone copy` — remote history is NEVER pruned even
# when the local 7-day rotation deletes old files (important for dues data).
#
# One-time setup:
#   1. Install rclone: https://rclone.org/install/
#   2. Configure: rclone config
#   3. Set RCLONE_REMOTE below and start with:
#      docker-compose --profile backup-remote up -d
#
# rclone remote name + path — REQUIRED when using backup-remote profile.
# Format: <remote-name>:<bucket-or-folder>
# RCLONE_REMOTE=gdrive:rollcall-backups
#
# Path to rclone.conf on the HOST (default: ~/.config/rclone — works for most installs).
# Override only if your rclone.conf is in a non-standard location.
# RCLONE_CONFIG_PATH=~/.config/rclone
#
# How often to ship backups to the remote. Default: 1 hour (3600 seconds).
# BACKUP_SYNC_INTERVAL_SECONDS=3600


# ── CLOUDFLARE TUNNEL ────────────────────────────────────────────────────────
#
# Moved to the blobsystems infra repo — this repo no longer runs a
# cloudflared sidecar. Set CLOUDFLARE_TUNNEL_TOKEN in blobsystems/.env
# instead (see ../blobsystems/.env.example).
